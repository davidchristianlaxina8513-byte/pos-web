# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.dev-exports/

# Old generated Expo output; untracked local folders may still exist.
.expo/
dist/

# Next.js
web/.next/
web/test-results/
web/playwright-report/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (templates *.example are tracked)
.env
.env.local
.env.development
.env.production

# typescript
*.tsbuildinfo

# editor / scratch
.vscode/
.superpowers/
docs/superpowers/

# planning scratch docs (never committed)
.opencode/plans/

# Supabase CLI link cache
supabase/.temp/

# editor lock files
.~lock.*#
