# Normalize text files to LF on checkout so Windows checkouts don't
# materialize CRLF line endings that fail `prettier --check`
# (prettier default endOfLine is "lf").
* text=auto eol=lf

# Windows-only scripts must stay CRLF if ever added (none tracked today).
*.{cmd,bat} text eol=crlf

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.zip binary
*.apk binary
*.aab binary
